rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Single small doc bumped on every product create/update/delete, so the
    // CI rebuild-trigger check can read one document instead of the entire
    // products collection to detect changes (keeps Firestore read usage far
    // under the free-tier daily quota even when polled every 5 minutes).
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact-form submissions: anyone can create one (the public form),
    // but only the signed-in admin can read, update (status/notes), or
    // delete them.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
